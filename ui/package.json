{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && touch ./dist/.gitkeep",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
